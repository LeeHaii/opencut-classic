{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-editor",
  "description": "IPC access for the OpenCut editor when loaded from a remote origin (dev server or production site)",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "https://localhost:3000",
      "https://127.0.0.1:3000",
      "https://opencut.pro",
      "https://www.opencut.pro"
    ]
  },
  "permissions": [
    "core:default",
    "fs:allow-appdata-read-recursive"
  ]
}
